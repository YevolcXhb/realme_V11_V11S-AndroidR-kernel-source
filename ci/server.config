# MT6833 server profile: merge after the OEM oppo6833[_debug]_defconfig.
CONFIG_MTK_SERVER_SCHEDUTIL=y
CONFIG_MTK_SERVER_SCHEDUTIL_UP_RATE_US=2000
CONFIG_MTK_SERVER_SCHEDUTIL_DOWN_RATE_US=20000
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_USB_MTK_HDRC=y
CONFIG_USB_MTK_OTG=y
CONFIG_MTK_USB_TYPEC=y
CONFIG_TCPC_MT6360=y
CONFIG_TCPC_CLASS=y
CONFIG_USB_POWER_DELIVERY=y
CONFIG_DUAL_ROLE_USB_INTF=y
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
