# Native-Linux (Ubuntu) requirements for RMX3122 / MT6833 (kernel 4.14.186)
#
# Merge after oppo6833_defconfig when the goal is a real Linux userspace
# instead of Android:
#
#   ./scripts/kconfig/merge_config.sh -m -O out out/.config ci/ubuntu.config
#   make O=out ARCH=arm64 olddefconfig
#
# With Android gone the MODVERSIONS / vendor-.ko ABI contract no longer
# applies, so config changes that shift exported struct layouts are allowed
# here. That is the main reason this file is separate from ci/server.config.

#
# devtmpfs: systemd, udev and basically every initramfs expect /dev to be
# populated by the kernel. Android does this from userspace with ueventd,
# which is exactly the part we are replacing.
#
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

#
# Virtual terminals and a text console on the built-in DSI panel.
# CONFIG_DRM_FBDEV_EMULATION is already y, which gives /dev/fb0 through the
# mediatek-drm driver; FRAMEBUFFER_CONSOLE turns that into a usable tty.
#
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y

#
# cgroup controllers systemd requires. CONFIG_CGROUPS, CGROUP_SCHED,
# CGROUP_FREEZER, CGROUP_CPUACCT and MEMCG are already y; the two missing
# ones are what systemd refuses to start without.
#
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG_SWAP=y

#
# systemd and friends
#
CONFIG_AUTOFS4_FS=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_SECCOMP_FILTER=y

#
# EROFS is not present in 4.14 (added in 4.19), so the Ubuntu rootfs stays
# ext4. ext4, FUSE, overlayfs and tmpfs are already enabled in the OEM
# defconfig; nothing to add for those.

#
# Networking bits a desktop expects that the OEM config leaves off
#
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_MACVLAN=y
CONFIG_DUMMY=y

#
# USB serial / input are already on. Keep HID and USB mass storage on so a
# keyboard and a stick work without extra work.
#
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_STORAGE=y