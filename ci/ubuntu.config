# Minimal native-Linux requirements for RMX3122 / MT6833 (kernel 4.14.186)
#
# This is deliberately SMALLER than ci/ubuntu-full.config. A kernel built with
# the full fragment boots into a reboot loop before init ever runs, and the
# diagnostic initramfs (which only mounts proc/sys/dev and sleeps) looped the
# same way - so the fault is in the kernel image, not in userspace.
#
# The prime suspect was CONFIG_VT + CONFIG_FRAMEBUFFER_CONSOLE: fbcon drives
# the DSI panel through mediatek-drm, and this handset has had its panel
# physically removed. fbcon has nothing to bind to, or binds to a half
# initialised display path.
#
# A headless Ubuntu server does not need a text console at all, and access is
# over the network, so drop VT/fbcon and the other speculative additions and
# keep only what systemd and the rootfs actually require.

#
# /dev must exist before the first userspace process. Android populates /dev
# from ueventd, which is exactly what is being replaced.
#
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

#
# cgroup controllers systemd refuses to start without. CGROUPS, CGROUP_SCHED,
# CGROUP_FREEZER, CGROUP_CPUACCT and MEMCG are already y in the OEM defconfig.
#
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y

#
# filesystem features systemd units and mounts expect
#
CONFIG_AUTOFS4_FS=y
CONFIG_FANOTIFY=y
CONFIG_SECCOMP_FILTER=y
#
# Strip the phone-specific subsystems this device cannot use without Android.
#
# With Android gone there is no modem manager, no connectivity daemon and no
# display consumer, yet all of them are built in. The modem data path in
# particular keeps raising NET_TX softirqs on interfaces that never carry a
# packet, which pinned every CPU at 100% softirq and made sshd unresponsive:
#
#   NET_TX:  254330245  702588140  ...  1062093419
#   %Cpu(s): 84.4 si
#
# None of these are needed to run a headless server over USB Ethernet.
#
#   MTK_MDDP_SUPPORT        modem data path
#   MTK_NET_CCMNI           creates ccmni0..ccmni20 virtual netdevs
#   MTK_ECCCI_DRIVER/_C2K/_CLDMA   modem control channels
#   MTK_CCCI_DEVICES        modem device layer
#   DRM_MEDIATEK            display controller; the panel is physically removed
#   LEDS_MTK_DISP           panel backlight
#
CONFIG_MTK_MDDP_SUPPORT=n

# Two things were tried and had to be reverted because the tree does not build
# without them:
#
#   CONFIG_MTK_CCCI_DEVICES=n
#     drivers/misc/mediatek/conn_md/include/conn_md_exp.h includes port_ipc.h,
#     which only ships inside the CCCI tree -> "fatal error: 'port_ipc.h' file
#     not found".
#
#   CONFIG_DRM_MEDIATEK=n
#     other vendor code calls DISP_GetScreenWidth/DISP_GetScreenHeight, which
#     live in the mediatek-drm objects -> "ld.lld: error: undefined symbol".
#
# So the only lever left is the modem data path itself. MTK_NET_CCMNI is
# force-selected while CCCI is on, so the ccmni netdevs still exist, but they
# no longer have MDDP behind them.
#
# Container runtime support (Docker / Podman / OCI).
#
# These were deliberately off in the Android era: enabling SYSVIPC or
# POSIX_MQUEUE changes struct task_struct and struct user_struct, which moves
# exported-symbol CRCs and stops the vendor modules from loading. That
# constraint is gone now - nothing imports those CRCs any more - so the
# prerequisites for namespaces and cgroup resource control can be turned on.
#
# Verified missing by resolving the Kconfig before this change:
#   IPC_NS (absent because both of its dependencies were off), USER_NS,
#   SYSVIPC, POSIX_MQUEUE, CFS_BANDWIDTH, MACVLAN, IP6_NF_NAT, VXLAN.
#
# Everything else a container runtime wants was already present: cgroups with
# memory/pids/devices/freezer/cpuacct/cpuset/blkio, veth, bridge, overlayfs,
# seccomp(+filter), nf_tables, iptables NAT/masquerade/reject, xt_addrtype.
#
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_MACVLAN=y
CONFIG_IP6_NF_NAT=y
CONFIG_VXLAN=y

# --- built-in MediaTek WLAN ---------------------------------------------------
# The gen4m Wi-Fi stack is an out-of-tree module built for the OEM kernel. Its
# prebuilt .ko files cannot load here because the CRCs in their __versions
# section no longer match this kernel's .config. Rather than fight kbuild's
# directory recursion to fold the vendor tree into vmlinux, the same sources are
# rebuilt as modules against out/.config (the "Build MediaTek WiFi modules" CI
# step); their CRCs belong to this kernel by construction. So the in-vmlinux
# switch stays off.
#
# Tested-firmware note: the vendor firmware for this board lives in
# /vendor/firmware inside the super partition and is placed there at install
# time. firmware_class.path=/vendor/firmware is already on the kernel cmdline.
# CONFIG_WLAN_DRV_BUILD_IN is not set

#
# Vendor kernel threads that exist to serve Android and, on this box, only
# inflate the load average while sitting in D state:
#
#   amms_task       OPPO/MTK AP+modem shared-memory manager. No modem here.
#   hang_detect1    AEE hang monitor. It sleeps in D for ever, and its whole
#                   job is to reboot the phone when something looks stuck -
#                   which is exactly the behaviour a headless server must not
#                   have.
#
# ps showed load average 3.8-4.1 with 94-97% of the CPU idle; the load came
# purely from tasks parked in D state. Removing these two takes 2 off that
# floor. CONFIG_RPMB is left alone: its thread waits on an OP-TEE session and
# disabling it risks the TEE build.
#
# CONFIG_MTK_AEE_HANG_DETECT is not set
# CONFIG_MTK_AMMS is not set
